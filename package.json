{
  "name": "tok",
  "version": "1.0.0",
  "description": "tok — standalone fast token counter. Pure-JS BPE (gpt-tokenizer), zero native deps, no network at runtime. Importable module + `tok` CLI.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tok": "./src/tok.ts"
  },
  "bin": {
    "tok": "./script/tok.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "bun": ">=1.4.3-canary", "node": ">=20" },
  "dependencies": {
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}